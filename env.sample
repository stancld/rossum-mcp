# When using AWS Bedrock Inference profile in a cluster
AWS_BEDROCK_MODEL_ARN=
AWS_BEDROCK_MODEL_ARN_SMALL=

API_TOKEN_OWNER=  # token owner used by rossum extensions
SPLITTING_SCREEN_FLAG_NAME=
SPLITTING_SCREEN_FLAG_VALUE=

ROSSUM_API_BASE_URL=
ROSSUM_API_TOKEN=

# Elasticsearch — per-deployment credentials (selected automatically based on org's deployment_location).
# Pattern: ELASTICSEARCH_{PREFIX}_URL where PREFIX is the uppercase deployment_location with hyphens replaced by underscores.
# Example: deployment_location="prod-eu2" → ELASTICSEARCH_PROD_EU2_URL.
# Falls back to generic ELASTICSEARCH_URL/USERNAME/PASSWORD if location-specific vars are not set.
ELASTICSEARCH_DEV_EU_URL=
ELASTICSEARCH_DEV_EU_USERNAME=
ELASTICSEARCH_DEV_EU_PASSWORD=
ELASTICSEARCH_PROD_EU2_URL=
ELASTICSEARCH_PROD_EU2_USERNAME=
ELASTICSEARCH_PROD_EU2_PASSWORD=
